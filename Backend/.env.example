# Copy this file to Backend/.env and fill in your own values. Never commit .env.

# PostgreSQL connection (local Docker database on port 5433)
DATABASE_URL=postgresql://uimm_user:change-me@localhost:5433/uimm_diagnostic_db

# JWT authentication: use a long random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Azure OpenAI (SWOT and report drafts)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=change-me
AZURE_OPENAI_MODEL=<your-deployment-name>
